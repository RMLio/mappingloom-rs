@prefix rml: <http://w3id.org/rml/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nf: <https://w3id.org/imec/knows/ns/rml/normal-form#> .
@prefix ex: <http://example.com/> .

ex:TM a rml:TriplesMap ; rml:logicalSource ex:LS ; rml:subjectMap ex:SM ;
  rml:baseIRI <http://example.com/base/> .
[] a rml:TriplesMap ; rml:logicalSource ex:LS ; rml:subjectMap ex:SM ;
  rml:baseIRI <http://example.com/base/> ;
  rml:predicateObjectMap ex:POM1 ; nf:origin ex:TM .
[] a rml:TriplesMap ; rml:logicalSource ex:LS ; rml:subjectMap ex:SM ;
  rml:baseIRI <http://example.com/base/> ;
  rml:predicateObjectMap ex:POM2 ; nf:origin ex:TM .
