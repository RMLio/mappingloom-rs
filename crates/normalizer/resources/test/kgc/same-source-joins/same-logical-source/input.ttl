@prefix rml: <http://w3id.org/rml/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nf: <https://w3id.org/imec/knows/ns/rml/normal-form#> .
@prefix ex: <http://example.com/> .

ex:TM rml:logicalSource ex:LS ;
  rml:predicateObjectMap [ rml:objectMap ex:ROM ] .
ex:ROM a rml:RefObjectMap ; rml:parentTriplesMap ex:Parent .
ex:Parent rml:logicalSource ex:LS ;
  rml:subjectMap [
      rml:template "p/{a}" ; rml:termType rml:IRI ; rml:graphMap ex:G ;
      rml:class ex:C
    ] .
