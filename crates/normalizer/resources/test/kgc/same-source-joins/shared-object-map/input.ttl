@prefix rml: <http://w3id.org/rml/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nf: <https://w3id.org/imec/knows/ns/rml/normal-form#> .
@prefix ex: <http://example.com/> .

# ex:ROM is shared by a triples map over the parent's source and one over
# another source, so it stays a join for both.
ex:TM1 rml:logicalSource ex:LS ;
  rml:predicateObjectMap [ rml:objectMap ex:ROM ] .
ex:TM2 rml:logicalSource ex:Other ;
  rml:predicateObjectMap [ rml:objectMap ex:ROM ] .
ex:ROM rml:parentTriplesMap ex:Parent .
ex:Parent rml:logicalSource ex:LS ; rml:subjectMap [ rml:reference "x" ] .
