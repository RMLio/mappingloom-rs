@prefix rml: <http://w3id.org/rml/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nf: <https://w3id.org/imec/knows/ns/rml/normal-form#> .
@prefix ex: <http://example.com/> .

ex:TM rml:logicalSource ex:LS ;
  rml:predicateObjectMap [ rml:objectMap ex:Joined, ex:Other ] .
ex:Joined rml:parentTriplesMap ex:Same ;
  rml:joinCondition [
      rml:childMap [ rml:reference "a" ] ;
      rml:parentMap [ rml:reference "b" ]
    ] .
ex:Other rml:parentTriplesMap ex:Elsewhere .
ex:Same rml:logicalSource ex:LS ; rml:subjectMap [ rml:reference "x" ] .
ex:Elsewhere rml:logicalSource ex:LS3 ;
  rml:subjectMap [ rml:reference "x" ] .
