@prefix rml: <http://w3id.org/rml/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nf: <https://w3id.org/imec/knows/ns/rml/normal-form#> .
@prefix ex: <http://example.com/> .

ex:OM1 rml:reference "a" ;
  rml:datatypeMap [ rml:constant ex:dt ; nf:origin ex:OM1 ] .
ex:OM2 rml:reference "b" ;
  rml:languageMap [ rml:constant "en" ; nf:origin ex:OM2 ] .
