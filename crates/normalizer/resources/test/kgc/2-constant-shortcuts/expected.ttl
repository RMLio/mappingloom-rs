@prefix rml: <http://w3id.org/rml/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nf: <https://w3id.org/imec/knows/ns/rml/normal-form#> .
@prefix ex: <http://example.com/> .

ex:TM rml:subjectMap [ rml:constant ex:s ; nf:origin ex:TM ] ;
  rml:predicateObjectMap ex:POM .
ex:POM rml:predicateMap [ rml:constant ex:p ; nf:origin ex:POM ] ;
  rml:objectMap [ rml:constant "o" ; nf:origin ex:POM ] ;
  rml:graphMap [ rml:constant ex:g ; nf:origin ex:POM ] .
