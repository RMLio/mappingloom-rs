@prefix rml: <http://w3id.org/rml/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nf: <https://w3id.org/imec/knows/ns/rml/normal-form#> .
@prefix ex: <http://example.com/> .

ex:JC rml:childMap [ rml:reference "c" ; nf:origin ex:JC ] ;
  rml:parentMap [ rml:reference "p" ; nf:origin ex:JC ] .
