{
  "$defs": {
    "Access": {
      "description": "Where a Source reads its records.",
      "oneOf": [
        {
          "description": "A file, at `path` relative to `root`.",
          "properties": {
            "path": {
              "type": "string"
            },
            "root": {
              "$ref": "#/$defs/Root"
            },
            "type": {
              "const": "File",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path",
            "root"
          ],
          "type": "object"
        },
        {
          "description": "One record without values.",
          "properties": {
            "type": {
              "const": "OneRecord",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Edge": {
      "description": "An edge from an operator to one that takes its output as input.",
      "properties": {
        "from": {
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputRole"
            },
            {
              "type": "null"
            }
          ],
          "description": "The input `from` is to a Join; absent for every other operator."
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "Encoding": {
      "description": "How a template encodes the values of its attributes:\nIRI-safe (RFC 3987 `iunreserved` kept),\nURI-safe (RFC 3986 `unreserved` kept),\nor not at all.",
      "enum": [
        "IriSafe",
        "UriSafe",
        "None"
      ],
      "type": "string"
    },
    "Expression": {
      "description": "An expression of an Extend: it maps an input tuple to a list of values or terms.\nUnless stated otherwise,\nan expression over several lists yields one result per combination of their elements,\nand nothing if one of them is absent.",
      "oneOf": [
        {
          "description": "The list bound to an attribute of the input tuple.",
          "properties": {
            "attribute": {
              "type": "string"
            },
            "type": {
              "const": "Reference",
              "type": "string"
            }
          },
          "required": [
            "type",
            "attribute"
          ],
          "type": "object"
        },
        {
          "description": "One `xsd:string` value per combination of the values of its attributes,\none value per attribute piece:\nthe pieces concatenated, each value's lexical form encoded by `encoding`.\nAbsent if any attribute is absent.",
          "properties": {
            "encoding": {
              "$ref": "#/$defs/Encoding"
            },
            "pieces": {
              "items": {
                "$ref": "#/$defs/Piece"
              },
              "type": "array"
            },
            "type": {
              "const": "Template",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pieces",
            "encoding"
          ],
          "type": "object"
        },
        {
          "description": "The one-element list of a complete term.",
          "properties": {
            "term": {
              "$ref": "#/$defs/Term"
            },
            "type": {
              "const": "Constant",
              "type": "string"
            }
          },
          "required": [
            "type",
            "term"
          ],
          "type": "object"
        },
        {
          "description": "Per value, its lexical form as an IRI if it is an absolute one,\notherwise `base` followed by it;\na data error if neither is a valid IRI.",
          "properties": {
            "base": {
              "description": "The IRI that a relative value follows;\nwithout it, only an absolute value gives an IRI.",
              "type": [
                "string",
                "null"
              ]
            },
            "inner": {
              "$ref": "#/$defs/Expression"
            },
            "type": {
              "const": "Iri",
              "type": "string"
            }
          },
          "required": [
            "type",
            "inner"
          ],
          "type": "object"
        },
        {
          "description": "As `Iri`, checked for an absolute URI instead of an absolute IRI.",
          "properties": {
            "base": {
              "type": [
                "string",
                "null"
              ]
            },
            "inner": {
              "$ref": "#/$defs/Expression"
            },
            "type": {
              "const": "Uri",
              "type": "string"
            }
          },
          "required": [
            "type",
            "inner"
          ],
          "type": "object"
        },
        {
          "description": "Per value, the blank node with its lexical form as identifier.",
          "properties": {
            "inner": {
              "$ref": "#/$defs/Expression"
            },
            "type": {
              "const": "BlankNode",
              "type": "string"
            }
          },
          "required": [
            "type",
            "inner"
          ],
          "type": "object"
        },
        {
          "description": "One fresh blank node per tuple, identified by `key` and the values of the `index` attributes.\nExpressions with the same key give the same node for the same index values.",
          "properties": {
            "index": {
              "description": "The attributes that identify the tuple's record, `#` first.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "key": {
              "type": "string"
            },
            "type": {
              "const": "FreshBlankNode",
              "type": "string"
            }
          },
          "required": [
            "type",
            "key",
            "index"
          ],
          "type": "object"
        },
        {
          "description": "Per value, a literal:\nits natural RDF literal,\nor one literal per datatype of `datatype`,\nor one per language tag of `language`.",
          "properties": {
            "datatype": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Expression"
                },
                {
                  "type": "null"
                }
              ]
            },
            "inner": {
              "$ref": "#/$defs/Expression"
            },
            "language": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Expression"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "const": "Literal",
              "type": "string"
            }
          },
          "required": [
            "type",
            "inner"
          ],
          "type": "object"
        }
      ]
    },
    "ExtendOp": {
      "description": "Binds new attributes, each to the list its expression gives on the input tuple.\nAn expression reads input attributes only, never a sibling's.",
      "properties": {
        "pairs": {
          "items": {
            "$ref": "#/$defs/ExtendPair"
          },
          "type": "array"
        }
      },
      "required": [
        "pairs"
      ],
      "type": "object"
    },
    "ExtendPair": {
      "properties": {
        "attribute": {
          "type": "string"
        },
        "expression": {
          "$ref": "#/$defs/Expression"
        },
        "origin": {
          "description": "The mapping nodes the expression comes from.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "attribute",
        "expression"
      ],
      "type": "object"
    },
    "Field": {
      "description": "A list field: the attribute bound to the values of a query per record.",
      "properties": {
        "attribute": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "single_valued": {
          "description": "Whether the query gives at most one value per record.",
          "type": "boolean"
        }
      },
      "required": [
        "attribute",
        "reference",
        "single_valued"
      ],
      "type": "object"
    },
    "InputRole": {
      "description": "Which input of a Join an edge gives.",
      "enum": [
        "Left",
        "Right"
      ],
      "type": "string"
    },
    "JoinKind": {
      "description": "What a Join gives for its matches.",
      "oneOf": [
        {
          "const": "Inner",
          "description": "The union t ∪ t′ of every matching tuple pair.",
          "type": "string"
        }
      ]
    },
    "JoinOp": {
      "description": "Joins the tuples of its Left and Right inputs, whose schemas are disjoint.\nA pair holds for a Left tuple t and a Right tuple t′\nif some value of t's attribute and some value of t′'s have the same lexical form,\nso an absent attribute never matches;\na tuple pair matches if every pair holds,\nso a Join without pairs gives the cartesian product.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/JoinKind"
        },
        "pairs": {
          "items": {
            "$ref": "#/$defs/JoinPair"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "pairs"
      ],
      "type": "object"
    },
    "JoinPair": {
      "description": "A Left and a Right attribute whose values a Join compares.",
      "properties": {
        "left": {
          "type": "string"
        },
        "right": {
          "type": "string"
        }
      },
      "required": [
        "left",
        "right"
      ],
      "type": "object"
    },
    "Node": {
      "properties": {
        "id": {
          "description": "Unique within the plan; it names the node for its edges only.",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/Operator"
        },
        "origin": {
          "description": "The IRIs of the mapping nodes this operator comes from, such as the data descriptions that a Source reads.\nAn origin is for provenance only;\nit never changes what a plan produces.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "operator"
      ],
      "type": "object"
    },
    "Operator": {
      "description": "An operator of the plan graph.\nA Source has no input and a Target no output;\na Join takes a Left and a Right input,\na Union and a Target any number of inputs,\nand every other operator exactly one.",
      "oneOf": [
        {
          "properties": {
            "config": {
              "$ref": "#/$defs/SourceOp"
            },
            "type": {
              "const": "Source",
              "type": "string"
            }
          },
          "required": [
            "type",
            "config"
          ],
          "type": "object"
        },
        {
          "properties": {
            "config": {
              "$ref": "#/$defs/ExtendOp"
            },
            "type": {
              "const": "Extend",
              "type": "string"
            }
          },
          "required": [
            "type",
            "config"
          ],
          "type": "object"
        },
        {
          "properties": {
            "config": {
              "$ref": "#/$defs/ProjectOp"
            },
            "type": {
              "const": "Project",
              "type": "string"
            }
          },
          "required": [
            "type",
            "config"
          ],
          "type": "object"
        },
        {
          "properties": {
            "config": {
              "$ref": "#/$defs/RenameOp"
            },
            "type": {
              "const": "Rename",
              "type": "string"
            }
          },
          "required": [
            "type",
            "config"
          ],
          "type": "object"
        },
        {
          "properties": {
            "config": {
              "$ref": "#/$defs/JoinOp"
            },
            "type": {
              "const": "Join",
              "type": "string"
            }
          },
          "required": [
            "type",
            "config"
          ],
          "type": "object"
        },
        {
          "description": "The bag union of inputs with equal schemas.",
          "properties": {
            "type": {
              "const": "Union",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "config": {
              "$ref": "#/$defs/SerializerOp"
            },
            "type": {
              "const": "Serializer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "config"
          ],
          "type": "object"
        },
        {
          "properties": {
            "config": {
              "$ref": "#/$defs/TargetOp"
            },
            "type": {
              "const": "Target",
              "type": "string"
            }
          },
          "required": [
            "type",
            "config"
          ],
          "type": "object"
        }
      ]
    },
    "Piece": {
      "description": "A piece of a template: literal text, or an attribute.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "attribute": {
              "type": "string"
            }
          },
          "required": [
            "attribute"
          ],
          "type": "object"
        }
      ]
    },
    "Position": {
      "anyOf": [
        {
          "properties": {
            "attribute": {
              "type": "string"
            }
          },
          "required": [
            "attribute"
          ],
          "type": "object"
        },
        {
          "properties": {
            "origin": {
              "description": "The mapping nodes the constant comes from.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "term": {
              "$ref": "#/$defs/Term"
            }
          },
          "required": [
            "term"
          ],
          "type": "object"
        }
      ],
      "description": "A position of a quad pattern:\nan attribute, `{\"attribute\": …}`,\nor a constant term, `{\"term\": …}`."
    },
    "ProjectOp": {
      "description": "Keeps the listed attributes.",
      "properties": {
        "attributes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "attributes"
      ],
      "type": "object"
    },
    "QuadPattern": {
      "properties": {
        "graph": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent for the default graph."
        },
        "object": {
          "$ref": "#/$defs/Position"
        },
        "origin": {
          "description": "The mapping nodes the pattern comes from.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "predicate": {
          "$ref": "#/$defs/Position"
        },
        "subject": {
          "$ref": "#/$defs/Position"
        }
      },
      "required": [
        "subject",
        "predicate",
        "object"
      ],
      "type": "object"
    },
    "RenameOp": {
      "description": "Renames attributes; the others keep their names.",
      "properties": {
        "pairs": {
          "items": {
            "$ref": "#/$defs/RenamePair"
          },
          "type": "array"
        }
      },
      "required": [
        "pairs"
      ],
      "type": "object"
    },
    "RenamePair": {
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "Root": {
      "description": "The directory a relative file path starts from.",
      "enum": [
        "MappingDirectory",
        "CurrentWorkingDirectory"
      ],
      "type": "string"
    },
    "SerializerOp": {
      "description": "Per tuple and pattern, one quad per combination of the four positions' lists;\nan absent position gives none.",
      "properties": {
        "patterns": {
          "items": {
            "$ref": "#/$defs/QuadPattern"
          },
          "type": "array"
        }
      },
      "required": [
        "patterns"
      ],
      "type": "object"
    },
    "SourceOp": {
      "description": "Yields one tuple per record:\n`#`, the record's zero-based position in the iteration,\nand each field bound to the list of its query's values.",
      "properties": {
        "access": {
          "$ref": "#/$defs/Access"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/Field"
          },
          "type": "array"
        },
        "iterator": {
          "type": [
            "string",
            "null"
          ]
        },
        "null_values": {
          "description": "The values that stand for no value, besides the format's own null.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "query_language": {
          "description": "The IRI of the query language of the iterator and the field references, such as JSONPath;\nabsent for `OneRecord` access.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "access",
        "fields"
      ],
      "type": "object"
    },
    "TargetOp": {
      "description": "Writes the set of the quads of its inputs.\nThe default Target takes its destination and serialization from the engine.",
      "properties": {
        "default": {
          "type": "boolean"
        }
      },
      "required": [
        "default"
      ],
      "type": "object"
    },
    "Term": {
      "anyOf": [
        {
          "properties": {
            "iri": {
              "type": "string"
            }
          },
          "required": [
            "iri"
          ],
          "type": "object"
        },
        {
          "description": "A literal with its lexical form and a datatype IRI or a language tag;\nwith neither, an `xsd:string`.",
          "properties": {
            "datatype": {
              "type": [
                "string",
                "null"
              ]
            },
            "language": {
              "type": [
                "string",
                "null"
              ]
            },
            "literal": {
              "type": "string"
            }
          },
          "required": [
            "literal"
          ],
          "type": "object"
        }
      ],
      "description": "A complete RDF term, as a constant gives it: `{\"iri\": …}` or `{\"literal\": …}`."
    }
  },
  "$id": "https://w3id.org/imec/knows/algemaploom/plan/plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A plan as it travels to an engine.",
  "properties": {
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "type": "array"
    },
    "version": {
      "description": "The version of the algemaploom-rs build that made the plan.",
      "type": "string"
    }
  },
  "required": [
    "version",
    "nodes",
    "edges"
  ],
  "title": "PlanDocument",
  "type": "object"
}
